{
  "name": "themaxsmith.com",
  "private": true,
  "type": "module",
  "description": "Personal site of Max Smith. Static HTML, no build step.",
  "homepage": "https://themaxsmith.com",
  "scripts": {
    "check": "node scripts/check.mjs",
    "serve": "python3 -m http.server 8080 --directory site",
    "deploy": "node scripts/check.mjs && gh-pages --dist site --dotfiles"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
